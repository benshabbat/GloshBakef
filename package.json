{
  "name": "gloshbakef",
  "version": "2.0.0",
  "description": "תוסף Chrome שמסתיר תמונות בעייתיות. הניתוח כולו מקומי: היוריסטיקת מילות חסימה ומודל NSFW שרץ במסמך offscreen יחיד.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/make-icons.mjs && node scripts/build.mjs",
    "dev": "node scripts/make-icons.mjs && node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs && node scripts/test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benshabbat/GloshBakef.git"
  },
  "keywords": ["chrome-extension", "content-filter", "nsfw", "manifest-v3", "on-device"],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/benshabbat/GloshBakef/issues"
  },
  "homepage": "https://github.com/benshabbat/GloshBakef#readme",
  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "esbuild": "^0.28.2",
    "nsfwjs": "^4.3.0"
  }
}
